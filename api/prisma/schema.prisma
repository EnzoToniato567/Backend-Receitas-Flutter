generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Receita {
  id           Int    @id @default(autoincrement())
  nome         String
  ingredientes String @db.Text
  modo_preparo String @db.Text
  url_imagem   String @db.Text
}
